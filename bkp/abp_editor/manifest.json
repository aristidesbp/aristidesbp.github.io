{
  "name": "Editor Mobile PWA",
  "short_name": "Editor",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#1e1e1e",
  "theme_color": "#1e1e1e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [".txt", ".md", ".csv"],
        "text/javascript": [".js"],
        "text/html": [".html"],
        "text/css": [".css"],
        "application/json": [".json"],
        "application/xml": [".xml"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "ficheiro",
          "accept": ["text/*", "application/pdf", ".txt", ".js", ".html", ".css", ".json", ".md", ".csv", ".xml", ".pdf"]
        }
      ]
    }
  }
}

