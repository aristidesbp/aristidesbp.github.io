{
  "name": "Editor Mobile PWA",
  "short_name": "Editor",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#1e1e1e",
  "theme_color": "#1e1e1e",
  "icons": [
    {
      "src": "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%230e639c'/><text x='50' y='65' font-size='50' text-anchor='middle' fill='white'>E</text></svg>",
      "sizes": "192x192",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/*": [".txt", ".js", ".html", ".css", ".json", ".md", ".csv", ".xml"]
      }
    }
  ],
  "share_target": {
    "action": "./partilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "ficheiro",
          "accept": ["text/*", ".txt", ".js", ".html", ".css", ".json", ".md", ".csv", ".xml"]
        }
      ]
    }
  }
}

